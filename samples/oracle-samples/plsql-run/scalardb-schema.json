{
  "hr.jobs": {"transaction": true, "partition-key": ["job_id"],
    "columns": {"job_id": "TEXT", "job_title": "TEXT", "min_salary": "DOUBLE", "max_salary": "DOUBLE"}},
  "hr.departments": {"transaction": true, "partition-key": ["department_id"], "secondary-index": ["department_name"],
    "columns": {"department_id": "INT", "department_name": "TEXT", "manager_id": "INT", "location": "TEXT"}},
  "hr.employees": {"transaction": true, "partition-key": ["employee_id"],
    "secondary-index": ["department_id", "manager_id", "job_id", "email"],
    "columns": {"employee_id": "INT", "first_name": "TEXT", "last_name": "TEXT", "email": "TEXT", "hire_date": "TIMESTAMP",
                "job_id": "TEXT", "salary": "DOUBLE", "commission_pct": "DOUBLE", "manager_id": "INT", "department_id": "INT"}},
  "hr.orders": {"transaction": true, "partition-key": ["order_id"], "secondary-index": ["status", "employee_id"],
    "columns": {"order_id": "BIGINT", "order_date": "TIMESTAMP", "employee_id": "INT", "customer": "TEXT", "status": "TEXT", "total": "DOUBLE"}},
  "hr.order_items": {"transaction": true, "partition-key": ["order_id"], "clustering-key": ["line_no ASC"],
    "columns": {"order_id": "BIGINT", "line_no": "INT", "product": "TEXT", "qty": "INT", "unit_price": "DOUBLE"}},
  "hr.emp_audit": {"transaction": true, "partition-key": ["audit_id"], "secondary-index": ["action"],
    "columns": {"audit_id": "BIGINT", "employee_id": "INT", "action": "TEXT", "old_salary": "DOUBLE", "new_salary": "DOUBLE",
                "changed_by": "TEXT", "changed_at": "TIMESTAMP", "message": "TEXT"}},
  "hr.bulk_target": {"transaction": true, "partition-key": ["employee_id"],
    "columns": {"employee_id": "INT", "last_name": "TEXT", "salary": "DOUBLE"}},
  "hr.emp_stage": {"transaction": true, "partition-key": ["employee_id"], "secondary-index": ["department_id"],
    "columns": {"employee_id": "INT", "last_name": "TEXT", "salary": "DOUBLE", "department_id": "INT"}},
  "hr.emp_high": {"transaction": true, "partition-key": ["employee_id"], "columns": {"employee_id": "INT", "salary": "DOUBLE"}},
  "hr.emp_low":  {"transaction": true, "partition-key": ["employee_id"], "columns": {"employee_id": "INT", "salary": "DOUBLE"}},
  "hr.sample_ddl": {"transaction": true, "partition-key": ["id"], "secondary-index": ["name"],
    "columns": {"id": "BIGINT", "name": "TEXT", "price": "DOUBLE", "tax_rate": "DOUBLE", "price_incl": "DOUBLE",
                "created_at": "TIMESTAMPTZ", "note": "TEXT", "category": "TEXT"}},
  "hr.products_json": {"transaction": true, "partition-key": ["id"], "columns": {"id": "BIGINT", "doc": "TEXT"}},
  "hr.sales_part": {"transaction": true, "partition-key": ["sale_id"], "columns": {"sale_id": "BIGINT", "sale_date": "DATE", "amount": "DOUBLE"}},
  "hr.gtt_work": {"transaction": true, "partition-key": ["id"], "columns": {"id": "BIGINT", "val": "TEXT"}}
}
