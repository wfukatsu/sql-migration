 "triggers": [
  {
   "name": "TRG_ITEMS_STOCK_GUARD",
   "table": "ORDER_ITEMS",
   "timing": "BEFORE EACH ROW",
   "event": "INSERT",
   "enabled": true,
   "body": "DECLARE\n    v_stock products.stock_quantity%TYPE;\nBEGIN\n    SELECT stock_quantity INTO v_stock FROM products WHERE product_id = :NEW.product_id;\n    IF v_stock < 0 THEN\n        RAISE_APPLICATION_ERROR(-20020, '在庫が負です');\n    END IF;\nEND trg_items_stock_guard;"
  },
  {
   "name": "TRG_ORDERS_AUDIT",
   "table": "ORDERS",
   "timing": "AFTER EACH ROW",
   "event": "UPDATE",
   "enabled": true,
   "body": "BEGIN\n    INSERT INTO audit_log (log_id, table_name, detail, logged_at)\n    VALUES (audit_seq.NEXTVAL, 'ORDERS', :OLD.status || ' -> ' || :NEW.status, SYSDATE);\nEND trg_orders_audit;"
  }
 ],
 "views": [
  {
   "name": "V_OPEN_ORDERS",
   "text": "SELECT o.order_id, o.customer_id, o.order_date, o.status\n  FROM orders o\n WHERE o.status <> 'CANCELLED'"
  },
  {
   "name": "V_ORDER_LINES",
   "text": "SELECT v.order_id, v.customer_id, i.line_no, i.product_id, i.quantity\n  FROM v_open_orders v\n  JOIN order_items i ON i.order_id = v.order_id"
  }
 ],
