  <diagram id="flow" name="仕組み (1 文の処理フロー)">
    <mxGraphModel dx="1200" dy="800" grid="0" page="1" pageWidth="1500" pageHeight="700">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="f_title" value="1 つの SQL 文がどう処理されるか" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#1F3A66;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="500" height="30" as="geometry" />
        </mxCell>

        <!-- 上段: ビルド時 -->
        <mxCell id="f_build" value="ビルド時 (変換ツール)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F6FF;strokeColor=#6C8EBF;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontSize=13;fontStyle=1;fontColor=#1F3A66;container=1;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="1420" height="250" as="geometry" />
        </mxCell>
        <mxCell id="s1" value="① 解析&lt;br&gt;&lt;font style=&quot;font-weight:normal&quot;&gt;SQLGlot で方言別に AST 化&lt;br&gt;文の分割、識別子の正規化&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;fontSize=11;fontStyle=1;" vertex="1" parent="f_build">
          <mxGeometry x="20" y="45" width="170" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="② ルール検査と書き換え&lt;br&gt;&lt;font style=&quot;font-weight:normal&quot;&gt;IN → OR 展開、NOT 押し下げ、DNF/CNF 化&lt;br&gt;ROWNUM/FETCH → LIMIT、(+) → LEFT JOIN&lt;br&gt;ON CONFLICT / MERGE → UPSERT、型対応&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;fontSize=11;fontStyle=1;" vertex="1" parent="f_build">
          <mxGeometry x="220" y="35" width="250" height="90" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="③ ScalarDB SQL の文法に収まるか" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;fontSize=11;fontStyle=1;" vertex="1" parent="f_build">
          <mxGeometry x="500" y="30" width="190" height="100" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="ScalarDB SQL を出力 (OK / WARN)&lt;br&gt;&lt;font style=&quot;font-weight:normal&quot;&gt;厳格な Generator: 文法に無い構文は例外&lt;br&gt;GET / SCAN / クロスパーティションの判定&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;fontStyle=1;" vertex="1" parent="f_build">
          <mxGeometry x="740" y="35" width="250" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s5" value="読み取り (SELECT / UNION / MINUS) か" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;fontSize=11;fontStyle=1;" vertex="1" parent="f_build">
          <mxGeometry x="500" y="140" width="190" height="90" as="geometry" />
        </mxCell>
        <mxCell id="s6" value="④ 分解 → 実行計画 JSON (PLANNED)&lt;br&gt;&lt;font style=&quot;font-weight:normal&quot;&gt;表ごとに col op literal の述語をプッシュダウン&lt;br&gt;使う列 + 主キーを取得列に&lt;br&gt;残余 SQL = 元の SQL (H2 向けの静的書き換え)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;fontStyle=1;" vertex="1" parent="f_build">
          <mxGeometry x="740" y="135" width="250" height="95" as="geometry" />
        </mxCell>
        <mxCell id="s7" value="ERROR として報告&lt;br&gt;&lt;font style=&quot;font-weight:normal&quot;&gt;書き込み系はフェーズ 3 のテンプレート&lt;br&gt;(読む → 計算 → 主キーで書く)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6E6;strokeColor=#C00000;fontSize=11;fontStyle=1;" vertex="1" parent="f_build">
          <mxGeometry x="220" y="150" width="250" height="70" as="geometry" />
        </mxCell>
        <mxCell id="ex1" value="例: SELECT e.ename, NVL(e.sal, 0) FROM emp e WHERE e.deptno IN (10, 20)&lt;br&gt;→ fetch: SELECT empno, ename, sal, deptno FROM emp WHERE (deptno = 10 OR deptno = 20)&lt;br&gt;→ 残余: 元の SQL を H2 Oracle モードで実行" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#1F3A66;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#6C8EBF;dashed=1;spacing=6;" vertex="1" parent="f_build">
          <mxGeometry x="1020" y="135" width="380" height="95" as="geometry" />
        </mxCell>
        <mxCell id="fe1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1F3A66;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="f_build" source="s1" target="s2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fe2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1F3A66;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="f_build" source="s2" target="s3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fe3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1F3A66;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="f_build" source="s3" target="s4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fe3l" value="はい" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;" vertex="1" connectable="0" parent="fe3"><mxGeometry x="-0.2" y="-10" relative="1" as="geometry" /></mxCell>
        <mxCell id="fe4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1F3A66;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="f_build" source="s3" target="s5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fe4l" value="いいえ (ERROR)" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;" vertex="1" connectable="0" parent="fe4"><mxGeometry x="0" y="0" relative="1" as="geometry"><mxPoint x="45" y="0" as="offset" /></mxGeometry></mxCell>
        <mxCell id="fe5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1F3A66;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="f_build" source="s5" target="s6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fe5l" value="はい" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;" vertex="1" connectable="0" parent="fe5"><mxGeometry x="-0.2" y="-10" relative="1" as="geometry" /></mxCell>
        <mxCell id="fe6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#C00000;strokeWidth=2;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="f_build" source="s5" target="s7"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fe6l" value="いいえ" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;" vertex="1" connectable="0" parent="fe6"><mxGeometry x="0" y="-10" relative="1" as="geometry" /></mxCell>
        <mxCell id="fe7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1F3A66;strokeWidth=1;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="f_build" source="s6" target="ex1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- 下段: 実行時 -->
        <mxCell id="f_run" value="実行時 (Java アプリケーション + ScalarDB)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2FAF0;strokeColor=#82B366;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontSize=13;fontStyle=1;fontColor=#2E5E2E;container=1;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="340" width="1420" height="330" as="geometry" />
        </mxCell>
        <mxCell id="r0" value="ScalarDB SQL を実行&lt;br&gt;&lt;font style=&quot;font-weight:normal&quot;&gt;JDBC ドライバ → ScalarDB Cluster&lt;br&gt;トランザクションはアプリが制御&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;fontStyle=1;" vertex="1" parent="f_run">
          <mxGeometry x="1150" y="45" width="230" height="70" as="geometry" />
        </mxCell>
        <mxCell id="r1" value="⑤ begin&lt;br&gt;&lt;font style=&quot;font-weight:normal&quot;&gt;ScalarDB トランザクション開始&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#82B366;fontSize=11;fontStyle=1;" vertex="1" parent="f_run">
          <mxGeometry x="20" y="160" width="150" height="60" as="geometry" />
        </mxCell>
        <mxCell id="r2" value="⑥ fetch (表ごと)&lt;br&gt;&lt;font style=&quot;font-weight:normal&quot;&gt;Core API または ScalarDB SQL&lt;br&gt;パーティション / インデックス /&lt;br&gt;クロスパーティション走査&lt;br&gt;行数上限を超えたら例外&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;fontStyle=1;" vertex="1" parent="f_run">
          <mxGeometry x="200" y="145" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="r3" value="⑦ commit&lt;br&gt;&lt;font style=&quot;font-weight:normal&quot;&gt;全表が同一スナップショット&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#82B366;fontSize=11;fontStyle=1;" vertex="1" parent="f_run">
          <mxGeometry x="450" y="160" width="150" height="60" as="geometry" />
        </mxCell>
        <mxCell id="r4" value="⑧ H2 in-memory に投入&lt;br&gt;&lt;font style=&quot;font-weight:normal&quot;&gt;リクエスト単位に生成&lt;br&gt;CREATE TABLE (ScalarDB 型 → H2 型)&lt;br&gt;MERGE で重複なく投入&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;fontStyle=1;" vertex="1" parent="f_run">
          <mxGeometry x="630" y="145" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="r5" value="⑨ 残余 SQL を実行&lt;br&gt;&lt;font style=&quot;font-weight:normal&quot;&gt;元の SQL を互換モードで&lt;br&gt;(MODE=Oracle / PostgreSQL / MySQL)&lt;br&gt;不足関数は OracleFunctions (UDF)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;fontStyle=1;" vertex="1" parent="f_run">
          <mxGeometry x="880" y="145" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="r6" value="⑩ 結果を返し H2 を破棄&lt;br&gt;&lt;font style=&quot;font-weight:normal&quot;&gt;永続化しない&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#82B366;fontSize=11;fontStyle=1;" vertex="1" parent="f_run">
          <mxGeometry x="1130" y="160" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="r_note" value="書き込み系 (フェーズ 3): ⑤〜⑦ の中で fetch → 残余 (キー抽出・計算) → 主キーで UPDATE / DELETE / INSERT / UPSERT を発行し、競合例外はトランザクション全体をリトライする。バックエンド DB には直接接続しない。" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#2E5E2E;whiteSpace=wrap;" vertex="1" parent="f_run">
          <mxGeometry x="20" y="260" width="1380" height="50" as="geometry" />
        </mxCell>
        <mxCell id="re0" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#7A4A00;strokeWidth=2;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="s4" target="r0">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="1450" y="130" /><mxPoint x="1450" y="325" /><mxPoint x="1305" y="325" /></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="re0l" value="変換済み文" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;" vertex="1" connectable="0" parent="re0"><mxGeometry x="0.2" y="-10" relative="1" as="geometry" /></mxCell>
        <mxCell id="re1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2E5E2E;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s6" target="r1">
          <mxGeometry relative="1" as="geometry">
