<mxCell id="ap" value="承認の記録 (flow.py)&lt;br&gt;&lt;font style=&quot;font-weight:normal&quot;&gt;承認した人・日付・承認したときのファイルの指紋 (spec には PL/SQL / SQL の原文も入る)。検査 (未記入が無い、図が入っている、事実の欄が古くない、決めた人のいない「決定」が無い) が通らなければ受け付けない。順番も飛ばせない&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E6;strokeColor=#D6A100;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="280" y="360" width="850" height="90" as="geometry" /></mxCell>
<mxCell id="e39" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#7A5600;strokeWidth=2;fontSize=10;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="g1" target="ap"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e40" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#7A5600;strokeWidth=2;fontSize=10;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="g2" target="ap"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e41" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#7A5600;strokeWidth=2;fontSize=10;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="g3" target="ap"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="st" value="承認のあとで原文・仕様書・決定・文書が変わる → 承認は「古い」になり、テストの関門が閉じる" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="280" y="480" width="850" height="50" as="geometry" /></mxCell>
<mxCell id="e42" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#B85450;strokeWidth=2;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="ap" target="st"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="nt" value="converted だけを取り直すかぎり、テストの結果は残る。spec か decisions を取り直すと、確かめた相手が変わるので結果は消える" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="280" y="550" width="850" height="50" as="geometry" /></mxCell>
