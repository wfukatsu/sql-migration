  <diagram id="d" name="4. データ構造 (Oracle の表 → ScalarDB の表)">
    <mxGraphModel dx="1200" dy="800" grid="0" page="1" pageWidth="920" pageHeight="430">
      <root>
<mxCell id="0" />
<mxCell id="1" parent="0" />
<mxCell id="d1" value="Oracle" style="rounded=1;arcSize=4;spacingLeft=6;whiteSpace=wrap;html=1;fillColor=#FFF4E0;strokeColor=#D79B00;strokeWidth=2;fontSize=14;fontColor=#D79B00;fontStyle=1;align=left;verticalAlign=top;spacing=4;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="300" height="300" as="geometry" /></mxCell>
<mxCell id="d2" value="&lt;b&gt;members&lt;/b&gt;&lt;br&gt;member_id NUMBER(10) &lt;b&gt;PK&lt;/b&gt;&lt;br&gt;name VARCHAR2(100)&lt;br&gt;rank VARCHAR2(10) DEFAULT &#x27;REGULAR&#x27;&lt;br&gt;balance NUMBER(10)&lt;br&gt;updated_at DATE" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;strokeWidth=1.5;fontSize=12;fontColor=#0F172A;fontStyle=0;align=left;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="14" y="30" width="272" height="118" as="geometry" /></mxCell>
<mxCell id="d3" value="&lt;b&gt;point_history&lt;/b&gt;&lt;br&gt;PK (member_id, seq_no)&lt;br&gt;points NUMBER(10)、created_at DATE" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;strokeWidth=1.5;fontSize=12;fontColor=#0F172A;fontStyle=0;align=left;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="14" y="160" width="272" height="64" as="geometry" /></mxCell>
<mxCell id="d4" value="INDEX idx_members_rank (rank)&lt;br&gt;SEQUENCE member_seq" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;strokeWidth=1.5;fontSize=12;fontColor=#0F172A;fontStyle=0;align=left;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="14" y="236" width="272" height="50" as="geometry" /></mxCell>
<mxCell id="d5" value="ScalarDB（namespace points）" style="rounded=1;arcSize=4;spacingLeft=6;whiteSpace=wrap;html=1;fillColor=#EAF2FB;strokeColor=#2673BB;strokeWidth=2;fontSize=14;fontColor=#2673BB;fontStyle=1;align=left;verticalAlign=top;spacing=4;" vertex="1" parent="1"><mxGeometry x="380" y="0" width="540" height="300" as="geometry" /></mxCell>
<mxCell id="d6" value="&lt;b&gt;points.members&lt;/b&gt;&lt;br&gt;&lt;b&gt;partition key&lt;/b&gt;: member_id BIGINT&lt;br&gt;name TEXT、rank TEXT、balance BIGINT&lt;br&gt;updated_at TIMESTAMP&lt;br&gt;&lt;b&gt;secondary index&lt;/b&gt;: rank" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2673BB;strokeWidth=1.5;fontSize=12;fontColor=#0F172A;fontStyle=0;align=left;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="394" y="30" width="300" height="118" as="geometry" /></mxCell>
<mxCell id="d7" value="&lt;b&gt;points.point_history&lt;/b&gt;&lt;br&gt;&lt;b&gt;partition key&lt;/b&gt;: member_id　&lt;b&gt;clustering key&lt;/b&gt;: seq_no ASC&lt;br&gt;points BIGINT、created_at TIMESTAMP" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2673BB;strokeWidth=1.5;fontSize=12;fontColor=#0F172A;fontStyle=0;align=left;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="394" y="160" width="512" height="64" as="geometry" /></mxCell>
<mxCell id="d8" value="索引名は落ちる（表 + 列で識別）。&lt;b&gt;sequence は無い&lt;/b&gt; → アプリで採番" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FDECEA;strokeColor=#C0392B;strokeWidth=1.5;fontSize=12;fontColor=#0F172A;fontStyle=0;align=left;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="394" y="236" width="512" height="50" as="geometry" /></mxCell>
<mxCell id="d9" value="&lt;b&gt;変わること&lt;/b&gt;&lt;br&gt;DEFAULT は落ちる（アプリが入れる）&lt;br&gt;DATE は時刻を持つ → TIMESTAMP&lt;br&gt;NUMBER(p,s) → DOUBLE か、スケール済み BIGINT" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF4E0;strokeColor=#D79B00;strokeWidth=1.5;fontSize=11;fontColor=#0F172A;fontStyle=0;align=left;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="706" y="30" width="200" height="118" as="geometry" /></mxCell>
